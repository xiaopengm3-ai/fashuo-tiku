<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
<head><title>中国近代法制 · 思维导图</title></head>
<body>
  <outline text="下编 中国近现代法制" _note="清末修律 → 南京临时 → 北洋 → 南京国民政府 → 革命根据地；以立法、宪法、刑事、民商、司法五线展开。" _page="p.149—184" _tag="总览">
        <outline text="第一章 立法概况" _note="近代立法体系如何建立：修律、六法全书与各政权立法。" _page="p.149—154" _tag="章">
            <outline text="清末修律" _note="收回领事裁判权、变法自强；沈家本、伍廷芳主持。" _page="p.149" _tag="制度">
                <outline text="修律动因" _note="收回领事裁判权、变法自强；1901《江楚会奏变法三折》。" _page="p.149" _tag="背景"/>
                <outline text="指导思想" _note="“中外通行，有裨治理”；“不戾乎中国数千年相传之礼教民情”。" _page="p.149" _tag="原则"/>
                <outline text="修律机关" _note="修订法律馆（1904 开始办公）；修律大臣沈家本、伍廷芳。" _page="p.149" _tag="机构"/>
                <outline text="主要特点" _note="借西法形式、固守君主专制与伦理纲常；诸法合体解体；保皇实质。" _page="p.150" _tag="特点"/>
                <outline text="历史意义" _note="中华法系解体；法律近代化基础；传播西法；推动资本主义与法学教育。" _page="p.150" _tag="意义"/>
      </outline>
            <outline text="南京临时政府法令" _note="无系统立法；以革命法令保障民权、发展经济、改革社会。" _page="p.150" _tag="制度">
                <outline text="保障民权" _note="《保护人民财产令》；禁止买卖人口、废除贱民、保护华侨。" _page="p.150" _tag="制度"/>
                <outline text="发展经济" _note="兴办实业、奖励农垦、鼓励华侨投资；商业注册、商业银行则例。" _page="p.150" _tag="制度"/>
                <outline text="文化教育" _note="奖励女学、男女同校、废止读经、禁用前清教科书。" _page="p.150" _tag="制度"/>
                <outline text="社会改革" _note="禁赌、剪辫、劝禁缠足、改革称呼旧制。" _page="p.150" _tag="制度"/>
      </outline>
            <outline text="北洋政府立法" _note="“隆礼”与“重刑”并重；大量单行法规与判例解释例。" _page="p.151" _tag="制度">
                <outline text="立法指导思想" _note="倡导伦理纲常、尊孔读经；隆礼重刑，严刑峻法。" _page="p.151" _tag="原则"/>
                <outline text="立法活动特点" _note="采西方原则；沿用删改清末法律；大量单行法规；判例解释例为重要渊源。" _page="p.151" _tag="特点"/>
      </outline>
            <outline text="南京国民政府立法" _note="三民主义、权能分治、五权宪法；六法全书体系。" _page="p.152—154" _tag="制度">
                <outline text="立法指导思想" _note="三民主义为核心；权能分治（政权/治权）；五权宪法；军政—训政—宪政。" _page="p.152" _tag="原则"/>
                <outline text="法律制度特点" _note="以孙中山遗教为根本；特别法多于普通法且效力高；六法全书；不成文法重要。" _page="p.153" _tag="特点"/>
                <outline text="立法阶段" _note="1927—1936 形成；1937—1945 发展（两面性）；1946—1949 完善与崩溃。" _page="p.153" _tag="背景"/>
                <outline text="六法全书" _note="宪法、民法、民诉、刑法、刑诉、行政法；基本法典+相关法规+判例解释例。" _page="p.153—154" _tag="法典"/>
      </outline>
    </outline>
        <outline text="第二章 宪法制度" _note="从清末预备立宪到 1947 年宪法，以及革命根据地宪法文件。" _page="p.155—164" _tag="章">
            <outline text="清末预备立宪" _note="1905 仿行宪政 → 1908 钦定宪法大纲 → 1911 十九信条。" _page="p.155—156" _tag="制度">
                <outline text="预备立宪时间线" _note="1905 五大臣考察；1906 宣示预备立宪；1907 筹设资政院/咨议局；1908 九年清单；1909 咨议局；1910 资政院；1911 十九信条。" _page="p.155" _tag="背景"/>
                <outline text="《钦定宪法大纲》" _note="1908；中国第一个宪法性文件；宪政编查馆；君上大权+臣民权利义务。" _page="p.155—156" _tag="法典"/>
                <outline text="《十九信条》" _note="1911；资政院；君主立宪；缩皇权、扩国会；未提人民权利。" _page="p.155—156" _tag="法典"/>
                <outline text="资政院与咨议局" _note="资政院中央咨询机关（1910）；咨议局地方咨询机关（1909）；形式议会、实为咨询。" _page="p.156" _tag="机构"/>
      </outline>
            <outline text="南京临时政府宪法" _note="《临时政府组织大纲》奠基，《临时约法》确立共和。" _page="p.156—158" _tag="制度">
                <outline text="《临时政府组织大纲》" _note="1911.12；各省都督府代表会议；总统制；参议院；临时中央审判所；未列人民权利。" _page="p.156" _tag="法典"/>
                <outline text="《临时约法》内容" _note="1912.3；7章56条；民主共和、三权分立、责任内阁、人民权利、私有财产。" _page="p.157" _tag="法典"/>
                <outline text="《临时约法》特点" _note="改总统制为责任内阁制；扩大参议院权力；特别修改程序（防袁）。" _page="p.158" _tag="特点"/>
                <outline text="《临时约法》意义" _note="第一部资产阶级共和国性质宪法文件；否定君主专制；因人立法局限。" _page="p.158" _tag="意义"/>
      </outline>
            <outline text="北洋政府宪法" _note="天坛宪草 → 袁记约法 → 贿选宪法，共和形式与军阀专制交织。" _page="p.159—160" _tag="制度">
                <outline text="天坛宪草" _note="1913；第一部宪法草案；责任内阁；国会权力+国会委员会；总统任期5年；审计院。" _page="p.159" _tag="法典"/>
                <outline text="袁记约法" _note="1914；总统制；废国会设参政院；总统10年可连任/世袭；权利受限。" _page="p.159" _tag="法典"/>
                <outline text="贿选宪法" _note="1923；第一部正式宪法；条文完备、形式民主；地方自治实为军阀势力范围。" _page="p.160" _tag="法典"/>
      </outline>
            <outline text="南京国民政府宪法" _note="训政纲领 → 训政时期约法 → 五五宪草 → 1947 年宪法。" _page="p.160—161" _tag="制度">
                <outline text="《训政纲领》" _note="1928；国民党一党专政、以党训政；中央政治会议领导政府。" _page="p.160" _tag="法典"/>
                <outline text="《训政时期约法》" _note="1931；党治；五院制；权利限制；发展官僚资本。" _page="p.160" _tag="法典"/>
                <outline text="《五五宪草》" _note="1936；未议决；1947 年宪法蓝本；总统制、国民大会、五院制衡。" _page="p.161" _tag="法典"/>
                <outline text="1947 年《中华民国宪法》" _note="三民主义/五权；国民大会；总统制受制约；中央地方分权；1948 年《动员戡乱时期临时条款》。" _page="p.161" _tag="法典"/>
      </outline>
            <outline text="革命根据地宪法" _note="工农民主、抗日民主、人民民主三种政权形态的宪法文件。" _page="p.162—164" _tag="制度">
                <outline text="《中华苏维埃共和国宪法大纲》" _note="1931；工农民主专政；工农兵代表大会；权利；外交；意义与局限。" _page="p.162" _tag="法典"/>
                <outline text="《陕甘宁边区施政纲领》" _note="1941；抗日/团结/民主；参议会+三三制；司法廉洁；经济文化。" _page="p.163" _tag="法典"/>
                <outline text="《陕甘宁边区宪法原则》" _note="1946；人民代表会议制；民主权利/民族区域自治；司法原则；经济文化。" _page="p.163" _tag="法典"/>
      </outline>
    </outline>
        <outline text="第三章 刑事法律制度" _note="从传统刑律向近代刑法典转型，及革命根据地刑事制度。" _page="p.165—169" _tag="章">
            <outline text="清末刑事立法" _note="《大清现行刑律》过渡，《大清新刑律》近代化，礼法之争收场。" _page="p.165—166" _tag="制度">
                <outline text="《大清现行刑律》" _note="1910.5；过渡；保留名例/诸法合体/十恶/律例合编；删酷刑缘坐、区分民刑、新罪名、五刑。" _page="p.165" _tag="法典"/>
                <outline text="《大清新刑律》" _note="1911.1；第一部近代专门刑法典；总则/分则+《暂行章程》；取消十恶；主刑5/从刑2；西原则。" _page="p.165—166" _tag="法典"/>
                <outline text="礼法之争" _note="礼教派张之洞、劳乃宣 vs 法理派沈家本、杨度；焦点5；结局《暂行章程》。" _page="p.166" _tag="对比"/>
      </outline>
            <outline text="北洋政府刑事" _note="沿用清末新刑律，增单行法规，刑罚趋酷。" _page="p.167" _tag="制度">
                <outline text="《暂行新刑律》" _note="以《大清新刑律》为基础；删帝制/皇室特权；改“帝国”为“中华民国”、“臣民”为“国民”。" _page="p.167" _tag="法典"/>
                <outline text="单行刑事法规" _note="《戒严法》《治安警察条例》《惩治盗匪法》《易笞条例》等；恢复发遣、笞刑。" _page="p.167" _tag="法典"/>
      </outline>
            <outline text="南京国民政府刑事" _note="1935 年新刑法采社会防卫主义，特别法重刑。" _page="p.167—168" _tag="制度">
                <outline text="1935 年《中华民国刑法》" _note="主观主义/社会防卫；保安处分；保留尊亲属加重、同居相隐、亲族盗免、纳妾；从新从轻。" _page="p.167" _tag="法典"/>
                <outline text="刑事特别法" _note="数量多、效力高、重刑；镇压共产党与进步人士。" _page="p.168" _tag="特点"/>
      </outline>
            <outline text="革命根据地刑事" _note="罪名、刑种、定罪量刑原则随政权性质变化。" _page="p.168—169" _tag="制度">
                <outline text="罪名" _note="抗日：汉奸、破坏坚壁财物、贪污；人民民主：战犯、地主恶霸、土匪、反动党团、会道门。" _page="p.168" _tag="制度"/>
                <outline text="刑种" _note="抗日主刑死刑/有期/劳役，从刑罚金/褫夺公权/没收；人民民主加无期、管制。" _page="p.168—169" _tag="制度"/>
                <outline text="定罪量刑原则" _note="工农民主5项；抗日3项；人民民主“首恶必办、胁从不问、立功受奖”。" _page="p.169" _tag="原则"/>
      </outline>
    </outline>
        <outline text="第四章 民商事法律制度" _note="民法典从草案到正式颁行，以及根据地土地、劳动、婚姻立法。" _page="p.170—177" _tag="章">
            <outline text="清末民商立法" _note="《大清民律草案》与商事立法，民商分立。" _page="p.170—171" _tag="制度">
                <outline text="《大清民律草案》" _note="1911.10；5编；民商分立；前3编松冈义正（日德瑞），后2编礼学馆传统；第一部民法典草案。" _page="p.170" _tag="法典"/>
                <outline text="商事立法" _note="1903—1907/1907—1911；《钦定大清商律》《公司注册试办章程》《商标注册试办章程》《破产律》等；特点3。" _page="p.170—171" _tag="法典"/>
      </outline>
            <outline text="北洋政府民商" _note="“现行律民事有效部分”为第一顺位法源，民律第二次草案未完成。" _page="p.171—172" _tag="制度">
                <outline text="民事法律渊源" _note="现行律民事有效部分（近20年）；单行法令；判例解释例；习惯法/条理。" _page="p.171" _tag="制度"/>
                <outline text="《民律第二次草案》" _note="1926；5编1522条；采固有法/判例；社会本位；未正式立法。" _page="p.172" _tag="法典"/>
                <outline text="商事法规" _note="《矿业条例》《森林法》《公司条例》《交易所法》《破产法草案》《票据法草案》等；多未完成立法。" _page="p.172" _tag="法典"/>
      </outline>
            <outline text="南京国民政府民商" _note="《中华民国民法》正式颁行，民商合一。" _page="p.173—174" _tag="制度">
                <outline text="《中华民国民法》" _note="1929—1930；5编；民商合一；最新学理/婚姻家庭固有法/习惯法理/私有财产/社会本位。" _page="p.173" _tag="法典"/>
                <outline text="单行商事立法" _note="银行法、交易所法、票据法、公司法、海商法、保险法、破产法。" _page="p.174" _tag="法典"/>
      </outline>
            <outline text="革命根据地民商" _note="土地、劳动、婚姻三大立法线，服务革命与根据地建设。" _page="p.175—177" _tag="制度">
                <outline text="土地立法" _note="井冈山1928/兴国1929/苏维埃土地法1931；抗日减租减息；五四指示1946；《中国土地法大纲》1947。" _page="p.175—176" _tag="法典"/>
                <outline text="劳动立法" _note="1931《中华苏维埃共和国劳动法》；抗日保护工人+团结资产阶级；1948 六次劳大。" _page="p.176—177" _tag="法典"/>
                <outline text="婚姻立法" _note="1934《中华苏维埃共和国婚姻法》（婚姻自由/婚龄/离婚自由）；抗日婚龄男20女18；人民民主政治条件/干部离婚。" _page="p.177" _tag="法典"/>
      </outline>
    </outline>
        <outline text="第五章 司法制度" _note="司法机构与诉讼审判制度的近代转型。" _page="p.178—184" _tag="章">
            <outline text="司法机构" _note="法院组织、审级、检察、领事裁判权与会审公廨。" _page="p.178—181" _tag="制度">
                <outline text="清末" _note="1906《大理院审判编制法》（第一部法院编制法、四级三审）；1910《法院编制法》；法部/大理院/审判厅/检察厅（审检合署）。" _page="p.178—179" _tag="机构"/>
                <outline text="领事裁判权" _note="1843《中英五口通商章程》《虎门条约》确立；被告主义；四类案件管辖。" _page="p.178—179" _tag="制度"/>
                <outline text="会审公廨" _note="1864 上海租界；1868《上海洋泾浜设官会审章程》；领事裁判权制度的延伸。" _page="p.179" _tag="机构"/>
                <outline text="南京临时政府" _note="临时中央审判所（未成立）/法院；司法部。" _page="p.179" _tag="机构"/>
                <outline text="北洋政府" _note="《暂行法院编制法》；平政院（最早行政诉讼）；四级三审；县知事兼理司法；军法审判。" _page="p.179—180" _tag="机构"/>
                <outline text="南京国民政府" _note="1932/1935《法院组织法》；三级三审；司法院/最高法院/行政法院/官吏惩戒委员会/特种刑事法庭。" _page="p.180" _tag="机构"/>
                <outline text="革命根据地" _note="工农民主四级二审/审检合一/政治保卫局；抗日两级两审/三级三审；人民民主三级三审/人民法庭。" _page="p.180—181" _tag="机构"/>
      </outline>
            <outline text="诉讼审判制度" _note="诉讼法近代化与各政权审判特点。" _page="p.181—184" _tag="制度">
                <outline text="清末诉讼法" _note="1906《刑事民事诉讼法草案》（陪审/律师，搁置）；1909《大清刑事诉讼律草案》；1909《大清民事诉讼律草案》（第一部法典化民诉草案）；改革5项。" _page="p.181—182" _tag="法典"/>
                <outline text="南京临时政府" _note="司法独立；禁止刑讯；禁止体罚；公开审判及陪审；律师制度。" _page="p.182" _tag="原则"/>
                <outline text="北洋政府" _note="四级三审；兼理司法法院；军法审判干预司法。" _page="p.182" _tag="特点"/>
                <outline text="南京国民政府" _note="刑诉1928/1935；民诉1930—31/1935；特点：严密侦查、自由心证、秘密审判、军法审判、美军特权。" _page="p.183" _tag="特点"/>
                <outline text="革命根据地" _note="抗日：马锡五审判方式、人民调解（方式/原则/范围/处理）；人民民主：废除六法全书、确定司法原则。" _page="p.183—184" _tag="制度"/>
      </outline>
    </outline>
  </outline>
</body>
</opml>
